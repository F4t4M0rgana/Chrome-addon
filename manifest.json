{
  "manifest_version": 3,
  "name": "Personal Image Zoom",
  "version": "1.4.0",
  "minimum_chrome_version": "120",
  "description": "Enlarge images in the current tab, zoom with the wheel, and press Y to copy.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Personal Image Zoom — right-click an image"
  },
